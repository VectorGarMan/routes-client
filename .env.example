# Variables de entorno para routes-api-frontend

# URL base del backend Spring Boot (sin barra al final)
VITE_API_BASE_URL=http://localhost:8080

# Activar modo mock (MSW) — true para simular el backend, false para usar el backend real
VITE_USE_MOCK=false

# Intervalo de polling del recálculo de ruta (en milisegundos)
VITE_RECALCULATE_INTERVAL_MS=30000

# Mapbox: token PÚBLICO (empieza con "pk.") para dibujar el mapa en el navegador.
# Usa uno distinto al del backend (MAPBOX_ACCESS_TOKEN) y restringe su URL en tu
# cuenta de Mapbox. NUNCA pongas aquí un token secreto ("sk."): VITE_* es visible.
# Sin token, el mapa cae a OpenStreetMap y muestra un aviso.
VITE_MAPBOX_TOKEN=
# Estilo del mapa (opcional). Ej.: mapbox/streets-v12, mapbox/outdoors-v12
VITE_MAPBOX_STYLE=mapbox/streets-v12
